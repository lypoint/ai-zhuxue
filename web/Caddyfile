# Use the confirmed HTTPS origins and absolute build roots, never historical release defaults.
{$WEB_PARENT_ORIGIN} {
    root * {$WEB_PARENT_ROOT}
    @assets path /assets/*
    encode @assets zstd gzip
    handle /api/browser/parent/* {
        uri strip_prefix /api
        reverse_proxy {$WEB_API_UPSTREAM} {
            header_up Host {hostport}
            flush_interval -1
        }
    }
    handle /api/* {
        respond 404
    }
    handle {
        try_files {path} /index.html
        file_server
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client https://cdn.paddle.com/paddle/v2/paddle.js; frame-src https://accounts.google.com https://sandbox-buy.paddle.com; connect-src 'self' https://accounts.google.com https://sandbox-buy.paddle.com https://sandbox-api.paddle.com; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' data: blob: https://*.googleusercontent.com; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
}

{$WEB_STUDENT_ORIGIN} {
    root * {$WEB_STUDENT_ROOT}
    @assets path /assets/*
    encode @assets zstd gzip
    handle /api/browser/student/* {
        uri strip_prefix /api
        reverse_proxy {$WEB_API_UPSTREAM} {
            header_up Host {hostport}
            flush_interval -1
        }
    }
    handle /api/* {
        respond 404
    }
    handle {
        try_files {path} /index.html
        file_server
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Cache-Control "no-store"
        Content-Security-Policy "default-src 'self'; script-src 'self'; connect-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
}
