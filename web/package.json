{
  "name": "ai-learning-international-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:parent": "vite --mode parent --host 127.0.0.1 --port 5173 --strictPort",
    "dev:student": "vite --mode student --host 127.0.0.1 --port 5174 --strictPort",
    "check": "node scripts/check-i18n.mjs && tsc --noEmit && node --test tests-unit/*.test.mjs",
    "build": "npm run check && vite build --mode parent && vite build --mode student",
    "test": "playwright test",
    "test:https": "npm run build && playwright test -c playwright.https.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.8",
    "i18next": "25.6.0",
    "katex": "0.19.0",
    "lucide-react": "0.468.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "16.2.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
