# Copy to .env.parent.local (ignored), or inject this JSON at build time.
# Use a dedicated Firebase Web app. Never use Android config or a service account key.
PARENT_FIREBASE_CONFIG={"apiKey":"YOUR_PUBLIC_WEB_API_KEY","appId":"1:123:web:YOUR_WEB_APP_ID","projectId":"YOUR_PROJECT_ID","measurementId":"G-YOURMEASUREMENTID"}
