# 复制为 .env 使用；生产环境一律经密管/编排注入，勿提交真实密钥
ENV=dev
DATABASE_URL=sqlite:///./aizhuxue.db
JWT_SECRET=change-me-in-prod
UPLOAD_DIR=./uploads

# 大模型（OpenAI 兼容；单价见 app/services/llm.py 注释，实价已核实 S50-S52）
LLM_PROVIDER=glm
GLM_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# CHAT_MODEL=glm-4-flash
# FENCE_MODEL=glm-4-flash

# 围栏：llm=分类+白名单+二次判定（验收形态）；heuristic=无 Key 降级，勿用于验收
FENCE_MODE=heuristic
FENCE_QUIET_ENABLED=true
FENCE_DAILY_MESSAGE_CAP=200

# 监护人三要素核验：mock（开发）| aliyun | tencent（生产接入待 M1）
GUARDIAN_VERIFY_PROVIDER=mock

# 家长端号码认证（生产必填；使用仅具 dypns:GetMobile、SendSmsVerifyCode、CheckSmsVerifyCode 权限的 RAM AccessKey）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_SCHEME_NAME=AI助学家长登录
