# 复制为 .env 使用；生产环境一律经密管/编排注入，勿提交真实密钥
ENV=dev
DATABASE_URL=sqlite:///./aizhuxue.db
JWT_SECRET=change-me-in-prod
UPLOAD_DIR=./uploads

# 大模型（OpenAI 兼容；单价见 app/services/llm.py 注释，实价已核实 S50-S52）
LLM_PROVIDER=glm
GLM_API_KEY=
# DEEPSEEK_API_KEY=
# KIMI_API_KEY=
# CHAT_MODEL=glm-4-flash
# FENCE_MODEL=glm-4-flash

# 围栏：llm=分类+白名单+二次判定（验收形态）；heuristic=无 Key 降级，勿用于验收
FENCE_MODE=heuristic
FENCE_QUIET_ENABLED=true
FENCE_DAILY_MESSAGE_CAP=200

# 监护人三要素核验：mock（开发）| aliyun | tencent（生产接入待 M1）
GUARDIAN_VERIFY_PROVIDER=mock

# 家长端号码认证（生产必填；使用仅具 dypns:GetMobile、SendSmsVerifyCode、CheckSmsVerifyCode 权限的 RAM AccessKey）
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=AI助学演示
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_SCHEME_NAME=AI助学家长登录

# 微信 APP 支付：demo 仅开发/测试可用。资质下来后替换配置并切换为 wechat。
PAYMENT_MODE=demo
WECHAT_APP_ID=wx_demo_parent_app
WECHAT_MCH_ID=demo_merchant
WECHAT_MERCHANT_SERIAL=DEMO_MERCHANT_SERIAL
WECHAT_API_V3_KEY=demo_only_0123456789012345678901
WECHAT_PRIVATE_KEY_PATH=/run/secrets/wechat_merchant_private.pem
# 微信支付平台公钥 ID（PUB_KEY_ID_...）与下载的公钥文件须配对。
WECHAT_PLATFORM_SERIAL=DEMO_PLATFORM_SERIAL
WECHAT_PLATFORM_PUBLIC_KEY_PATH=/run/secrets/wechat_platform_public.pem
WECHAT_NOTIFY_URL=https://demo.example.com/payments/wechat/notify

# Store subscription mapping: register one auto-renewing monthly product per tier.
STORE_PRODUCTS_JSON={"appstore":{"family_monthly_1":"family.monthly.1","family_monthly_2":"family.monthly.2","family_monthly_10":"family.monthly.10","family_monthly_100":"family.monthly.100"},"googleplay":{"family_monthly_1":"family_monthly_1","family_monthly_2":"family_monthly_2","family_monthly_10":"family_monthly_10","family_monthly_100":"family_monthly_100"}}
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORE_TOKEN_SECRET=
# Review/test purchases in production require allowlisted family account UUIDs. Empty denies all.
STORE_TEST_ACCOUNT_TOKENS=
APPLE_ENVIRONMENT=Production
APPLE_BUNDLE_ID=com.aizhuxue.appParent
APPLE_APP_ID=0
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=/run/store/apple.p8
APPLE_ROOT_CERT_PATHS=/run/store/AppleRootCA-G3.cer
# OAuth Web client ID for Google Play account login (not a client secret).
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_PACKAGE_NAME=com.aizhuxue.parent.play
GOOGLE_SERVICE_ACCOUNT_PATH=/run/store/google-service-account.json
# Optional dedicated HTTPS relay. Keep its shared token in the secret manager.
GOOGLE_GATEWAY_URL=
GOOGLE_GATEWAY_TOKEN=
GOOGLE_PUBSUB_AUDIENCE=https://api.example.com/payments/googleplay/notify
GOOGLE_PUBSUB_EMAIL=

# 图片一期：先配置私有 Kodo、审核和 CMS 模型，再开启开关。
IMAGE_FEATURES_ENABLED=false
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# 私有 HTTPS 域名，或 https://<bucket>.s3.cn-east-1.qiniucs.com（浙江）。
QINIU_DOMAIN=https://images.example.com
# 按 Bucket 区域选择上传域名；示例是华东。
QINIU_UPLOAD_URL=https://upload.qiniup.com
QINIU_CENSOR_URL=https://ai.qiniuapi.com/v3/image/censor
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_PIXELS=20000000
# 安装有中文/目标语言字形的字体，例：Noto Sans CJK。
IMAGE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
